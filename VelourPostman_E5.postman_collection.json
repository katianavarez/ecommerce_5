              "path": ["api", "carrito", "producto", "1", "talla", "M"]
            }
          }
        },
        {
          "name": "VaciarCarrito",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/carrito",
              "host": ["{{baseUrl}}"],
              "path": ["api", "carrito"]
            }
          }
        }
      ]
    },
