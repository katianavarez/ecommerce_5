{
  "info": {
    "_postman_id": "f779c939-87b5-4b16-a6a9-722ba7136bc5",
    "name": "VelourPostman_E5",
    "description": "API REST del proyecto Velour (Equipo 5).\n\nVariables de colección:\n- baseUrl: http://localhost:8080/ECommerceWebAplication\n- token: se autocompleta tras correr 'Auth › Login'.\n- usuarioId: idem.\n\nFlujo sugerido: Login → ListarProductos → AgregarCarrito → CrearPedido.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl",   "value": "http://localhost:8080/ECommerceWebAplication", "type": "string" },
    { "key": "token",     "value": "",                                              "type": "string" },
    { "key": "usuarioId", "value": "",                                              "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (cliente seed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Login OK', () => pm.response.to.have.status(200));",
                  "if (res && res.data) {",
                  "  pm.collectionVariables.set('token', res.data.token || '');",
                  "  pm.collectionVariables.set('usuarioId', String(res.data.usuarioId || ''));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"equipo@gmail.com\",\n  \"contrasena\": \"Cliente123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login (admin seed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data) {",
                  "  pm.collectionVariables.set('token', res.data.token || '');",
                  "  pm.collectionVariables.set('usuarioId', String(res.data.usuarioId || ''));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@gmail.com\",\n  \"contrasena\": \"Admin1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Registro (nuevo cliente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data) {",
                  "  pm.collectionVariables.set('token', res.data.token || '');",
                  "  pm.collectionVariables.set('usuarioId', String(res.data.usuarioId || ''));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cliente Demo\",\n  \"correo\": \"demo@velour.mx\",\n  \"contrasena\": \"Demo12345\",\n  \"telefono\": \"6440000001\",\n  \"calle\": \"Av. Demo 100\",\n  \"ciudad\": \"Cd. Obregón\",\n  \"estado\": \"Sonora\",\n  \"codigoPostal\": \"85000\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "registro"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Productos",
      "item": [
        {
          "name": "ListarProductos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/productos?page=1&size=12",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "size", "value": "12" }
              ]
            }
          }
        },
        {
          "name": "ListarProductos (con filtros)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/productos?categoriaId=1&talla=M&color=NEGRO&precioMax=2000&soloConStock=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos"],
              "query": [
                { "key": "categoriaId",  "value": "1" },
                { "key": "talla",        "value": "M" },
                { "key": "color",        "value": "NEGRO" },
                { "key": "precioMax",    "value": "2000" },
                { "key": "soloConStock", "value": "true" }
              ]
            }
          }
        },
        {
          "name": "BuscarProductos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/productos?busqueda=vestido",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos"],
              "query": [{ "key": "busqueda", "value": "vestido" }]
            }
          }
        },
        {
          "name": "DetalleProducto",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/productos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos", "1"]
            }
          }
        }
      ]
    },
    {
