<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence              https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
  <persistence-unit name="Ecommerce" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <class>itson.ecommercewebaplication.models.Usuario</class>
    <class>itson.ecommercewebaplication.models.Carrito</class>
    <class>itson.ecommercewebaplication.models.Categoria</class>
    <class>itson.ecommercewebaplication.models.DetallePedido</class>
    <class>itson.ecommercewebaplication.models.Direccion</class>
    <class>itson.ecommercewebaplication.models.Pago</class>
    <class>itson.ecommercewebaplication.models.Pedido</class>
    <class>itson.ecommercewebaplication.models.Producto</class>
    <class>itson.ecommercewebaplication.models.Resenia</class>
    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
      <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/ecommerce_db?useSSL=false&amp;serverTimezone=UTC"/>
      <property name="jakarta.persistence.jdbc.user" value="root"/>
      <property name="jakarta.persistence.jdbc.password" value="alther"/>
      <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
      <property name="hibernate.hbm2ddl.auto" value="update"/>
      <property name="hibernate.show_sql" value="true"/>
      <property name="hibernate.format_sql" value="true"/>
    </properties>
  </persistence-unit>
</persistence>
