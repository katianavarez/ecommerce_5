<%@ page pageEncoding="UTF-8" %>

<div class="header-top">
    Envío gratis en compras mayores a $1,500 MXN &nbsp;·&nbsp;
    <a href="${pageContext.request.contextPath}/productos">Ver colección →</a>
</div>
<div class="header-main">
    <a href="${pageContext.request.contextPath}/" class="site-logo">
        <div class="site-logo__wordmark">Vel<span>our</span></div>
        <div class="site-logo__sub">Moda de Autor</div>
    </a>

    <nav class="main-nav">
        <a href="${pageContext.request.contextPath}/" class="main-nav__link">Inicio</a>
        <a href="${pageContext.request.contextPath}/productos" class="main-nav__link">Colección</a>
    </nav>

    <form class="search-form" role="search" action="${pageContext.request.contextPath}/productos" method="get">
        <input class="search-form__input" type="search" name="q" placeholder="Buscar prendas...">
        <button class="search-form__btn" type="submit" aria-label="Buscar">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <circle cx="11" cy="11" r="7"/><path d="m21 21-4.35-4.35"/>
            </svg>
        </button>
    </form>

    <div class="header-right">
        <div class="header-actions">
            <a href="${pageContext.request.contextPath}/cuenta" class="header-icon" aria-label="Mi cuenta">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                </svg>
            </a>
            <a href="${pageContext.request.contextPath}/carrito" class="header-icon" aria-label="Carrito">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
                </svg>
                <span class="cart-badge">${sessionScope.carrito != null ? sessionScope.carrito.detalles.size() : 0}</span>
            </a>
        </div>

        <button class="header-burger" aria-label="Menú" id="burgerBtn">
            <span></span><span></span><span></span>
        </button>
    </div>
</div>

<nav class="mobile-nav" id="mobileNav">
    <a href="${pageContext.request.contextPath}/" class="mobile-nav__link">Inicio</a>
    <a href="${pageContext.request.contextPath}/productos" class="mobile-nav__link">Colección</a>
    <a href="${pageContext.request.contextPath}/carrito" class="mobile-nav__link">
        Carrito (${sessionScope.carrito != null ? sessionScope.carrito.detalles.size() : 0})
    </a>
</nav>
